#!/usr/bin/env sh

HISTFILE="${HISTFILE:-${HOME}/.zsh_history}"

cp "${HISTFILE}" "${HISTFILE}".pre-dedup \
  && tac "${HISTFILE}" | LC_ALL=C awk -F';' '
      {
        idx = index($0, ";")
        if (idx > 0) {
          prefix = substr($0, 1, idx)
          key = substr($0, idx + 1)
        } else {
          prefix = ""
          key = $0
        }
        gsub(/^[ \t]+|[ \t]+$/, "", key)
        if (!seen[key]++) print prefix key
      }
    ' | tac \
    > "${HISTFILE}".dedup \
  && mv "${HISTFILE}".dedup "${HISTFILE}"